  "narrative": {
    "northStar": "The Record Book",
    "overview": "The homepage is a dark desk with a record book under a lamp; every other page is a leaf of that book, in paper, dark ink and ink-blue. The site is a record kept by a working educator, not a showcase.",
    "keyCharacteristics": [
      "Dark desk on the homepage, paper leaves everywhere else.",
      "Serif display (Newsreader) over a quiet sans body (Inter).",
      "One warm accent on the desk (lamp amber), one cool accent on paper (ink blue).",
      "Flat leaves with one soft shadow for the sheet itself; no stacked card shadows.",
      "Motion only where it shows how the book works."
    ],
    "rules": [
      {
        "name": "The Two-Palette Rule",
        "body": "Desk colours never appear on a paper leaf and paper colours never appear on the desk, except the ribbon bookmark.",
        "section": "colors"
      },
      {
        "name": "The Oxide Rule",
        "body": "Oxide marks difficulty only.",
        "section": "colors"
      },
      {
        "name": "The Contrast Rule",
        "body": "Body text 4.5:1; large text and UI boundaries 3:1; re-measure with a tool.",
        "section": "colors"
      },
      {
        "name": "The Measure Rule",
        "body": "Prose lines are 60 to 72 characters (max-width 68ch).",
        "section": "typography"
      },
      {
        "name": "The Hierarchy Rule",
        "body": "One h1 per page, then h2 and h3 without skipping levels.",
        "section": "typography"
      },
      {
        "name": "The Font-Loading Rule",
        "body": "Move fonts off CSS @import to preconnect plus link, or self-host WOFF2.",
        "section": "typography"
      },
      {
        "name": "The One Shadow Rule",
        "body": "Only the sheet and the homepage text card cast shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the homepage as the dark desk and every other page as a paper leaf.",
      "Do use Newsreader for headings and eyebrows and Inter for body text.",
      "Do keep prose at 60 to 72 characters wide.",
      "Do mark difficulty with Oxide and nothing else.",
      "Do put the evidence, its caption and its link in the main reading flow.",
      "Do show missing evidence as missing."
    ],
    "donts": [
      "Don't use scroll-jacking, long pinned sequences or more than one sticky storytelling sequence per module page.",
      "Don't stack fixed or sticky layers.",
      "Don't use image collages as decoration or place text directly over busy images.",
      "Don't publish media without alt text.",
      "Don't load every evidence image immediately.",
      "Don't hide navigation behind a toggle on a case-study page.",
      "Don't add decorative motion that does not communicate learning.",
      "Don't add GSAP ScrollTrigger or any animation library, or migrate to a framework.",
      "Don't replace the WebGL homepage.",
      "Don't drift toward a generic AI start-up, design-agency, resume or personal-brand look."
    ]
  }
